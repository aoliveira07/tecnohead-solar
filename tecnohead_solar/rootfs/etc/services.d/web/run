#!/command/with-contenv bash
set -euo pipefail

until pg_isready -h /run/tecnohead-solar -p 55432 -U solar_app -d tecnohead_solar >/dev/null 2>&1; do
  sleep 1
done

exec s6-setuidgid solarapp python3 -m uvicorn \
  tecnohead_solar.main:app \
  --host 0.0.0.0 \
  --port 8099 \
  --proxy-headers \
  --forwarded-allow-ips 172.30.32.2
